# -----------------------------------------------------------------------------
# F-Ex Store — copy this file to .env.local for local development and add the
# same values in Vercel > Project Settings > Environment Variables.
# Never commit real secrets. Values containing TODO/XXXX are placeholders.
# -----------------------------------------------------------------------------

# Public site URL / analytics
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Demo mode is for NO-DATABASE previews only. In production set this to false.
# Public sample content still renders without a database, but admin edits in
# demo mode are per-process and NOT durable across Vercel serverless instances.
DEMO_MODE="false"
DEMO_OWNER_EMAIL="owner@fexstore.in"
DEMO_OWNER_PASSWORD="ChangeMe123!"

# MongoDB Atlas. Include the database name in the URI path.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/f-ex-store?retryWrites=true&w=majority"

# NextAuth credentials. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Owner account created by `npm run seed` (the seed script is destructive).
SEED_OWNER_NAME="F-Ex Store Owner"
SEED_OWNER_EMAIL="owner@fexstore.in"
SEED_OWNER_PASSWORD="ChangeMe123!"

# Optional BranchStaff account for `npm run seed:staff`.
STAFF_NAME="Lokhra Staff"
STAFF_EMAIL="lokhra@fexstore.in"
STAFF_PASSWORD="ChangeStaff123!"
STAFF_BRANCH="lokhra"

# Cloudinary signed direct uploads. The API secret is server-only.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_FOLDER="f-ex-store"

# Resend lead notifications. LEAD_FROM_EMAIL must use a verified domain.
# LEAD_NOTIFICATION_EMAIL accepts one address or a comma-separated list.
RESEND_API_KEY="re_your_api_key"
LEAD_FROM_EMAIL="F-Ex Store <leads@your-verified-domain.com>"
LEAD_NOTIFICATION_EMAIL="owner@fexstore.in"
